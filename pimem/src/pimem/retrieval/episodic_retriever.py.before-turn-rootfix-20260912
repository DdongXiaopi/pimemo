_SESSION_GENERIC_TERMS = {
    "previous", "conversation", "chat", "remind", "checking", "about", "planning", "revisit",
    "looking", "going", "through", "follow", "earlier", "last", "time", "wondering", "could",
    "specific", "certain", "again", "back", "mentioned", "suggested", "recommended",
}

_SESSION_TOKEN_ALIASES = {
    "recommend": {"recommend", "recommended", "recommendation", "suggest", "suggested"},
    "restaurant": {"restaurant", "restaurants", "eatery", "cafe", "cafes"},
    "name": {"name", "named", "nickname", "called"},
    "wearing": {"wear", "wears", "wore", "wearing", "shirt", "dress", "coat", "jacket", "outfit"},
    "designation": {"designation", "designated", "code", "number", "file"},
    "allocated": {"allocated", "allocation", "allocate", "budget", "cost", "amount"},
    "campaign": {"campaign", "campaigns", "plan", "planning"},
    "construction": {"construction", "construct", "constructed", "building", "began", "started"},
}


def _token_family(token: str) -> set[str]:
    normalized = token.lower().strip()
    aliases = _SESSION_TOKEN_ALIASES.get(normalized)
    if aliases:
        return aliases
    variants = {normalized}
    for suffix in ("ing", "ed", "es", "s"):
        if normalized.endswith(suffix) and len(normalized) > len(suffix) + 2:
            variants.add(normalized[:-len(suffix)])
    return variants


def _literal_present(content: str, literal: str) -> bool:
    normalized_content = re.sub(r"\s+", " ", content.lower()).strip()
    normalized_literal = re.sub(r"\s+", " ", literal.lower()).strip()
    return bool(normalized_literal and normalized_literal in normalized_content)


def _literal_strength(content: str, literals: List[str]) -> Tuple[int, int]:
    significant = [literal for literal in literals if len(literal.split()) > 1 or len(literal.strip()) >= 3]
    matches = [literal for literal in significant if _literal_present(content, literal)]
    return len(matches), max((len(literal) for literal in matches), default=0)


_slot_matches = slot_matches


def _focused_closure_rank(item: Dict[str, Any], primary: Dict[str, Any]) -> Tuple[int, ...]:
    turn_distance = abs(int(item.get("turn_index") or 0) - int(primary.get("turn_index") or 0))
    typed_evidence = sum(int(item.get(field, 0) or 0) for field in (
        "requested_entity_hits", "literal_hits", "ordinal_match", "typed_field_match",
        "currency_relevance", "numeric_hits", "relation_hits", "unit_score",
    ))
    same_question = int(bool(item.get("question_turn_id") and item.get("question_turn_id") == primary.get("question_turn_id")))
    adjacent = int(turn_distance <= 1)
    complementary_role = int(item.get("role") != primary.get("role"))
    return (typed_evidence, same_question, adjacent, complementary_role,
            -turn_distance, int(float(item.get("score", 0) or 0)))


def _question_like_turn(item: Dict[str, Any]) -> bool:
    speech_act = str(item.get("speech_act") or "")
    pair_type = str(item.get("pair_type") or "")
    content = str(item.get("content") or "").strip()
    return (
        speech_act in {"user_question", "assistant_question", "question"}
        or pair_type in {"user_without_preceding_question", "missing_source_pair"}
        or content.endswith("?")
        or bool(re.match(
            r"^(?:what|which|when|where|who|why|how|can|could|would|should|do|did|does|is|are|was|were)\b",
            content,
            flags=re.IGNORECASE,
        ))
    )


def _contract_item_rank(item: Dict[str, Any], plan: QueryPlan | None = None) -> Tuple[int, ...]:
    """Rank a candidate by explicit answer-contract evidence."""
    requested_slots = [
        slot for slot in ((plan.requested_slots if plan else []) or [])
        if _slot_matches(slot, item)
    ]
    answer_units = item.get("answer_units") or []
    unit_kinds = {str(unit.get("kind") or "") for unit in answer_units}
    unit_kinds.update(str(facet.get("kind") or "") for facet in (item.get("facets") or []))
    field_kinds = {
        "phone_number": {"phone_number"},
        "amount": {"numeric_value", "percentage", "ratio"},
        "percentage": {"percentage", "numeric_value"},
        "ratio": {"ratio", "numeric_value"},
        "year": {"year", "numeric_value"},
        "date": {"date", "year", "numeric_value"},
        "duration": {"numeric_value"},
        "count": {"numeric_value"},
        "attribute": {"attribute_value", "attribute_sentence", "typed_sentence", "quoted_span", "list_item", "table_cell", "table_coordinate", "table_row"},
        "value": {"attribute_value", "attribute_sentence", "typed_sentence", "quoted_span", "list_item", "table_cell", "table_coordinate", "table_row"},
    }
    field_evidence = int(bool(plan and any(unit_kinds & field_kinds.get(str(field), {str(field)}) for field in (plan.fields or []))))
    ordinal_requested = bool(plan and getattr(plan, "ordinal_constraints", None))
    ordinal_evidence = int(bool(item.get("ordinal_match"))) if ordinal_requested else 0
    list_evidence = int("list_item" in unit_kinds)
    table_evidence = int(bool(unit_kinds & {"table_coordinate", "table_cell", "table_row"}))
    literal_units = [unit for unit in answer_units if str(unit.get("kind") or "") == "special_literal"]
    literal_evidence = int(bool(item.get("literal_full_hits") or literal_units))
    literal_length = max(
        int(item.get("literal_max_length") or 0),
        max((len(str(unit.get("value") or unit.get("text") or "")) for unit in literal_units), default=0),
    )
    relation_evidence = max(int(item.get("typed_relation_score") or 0), int(item.get("relation_hits") or 0))
    numeric_evidence = int(item.get("numeric_hits") or 0) + int(item.get("typed_field_match") or 0)
    discriminative_evidence = int(item.get("answer_discriminative_hits") or 0)
    continuation_evidence = int(bool(
        plan
        and plan.answer_shape == "literal"
        and "after" in (plan.referential_terms or [])
        and item.get("role") == "assistant"
        and (item.get("preceding_terminal_literal_hits") or item.get("preceding_literal_hits"))
    ))
    anchor_evidence = int(item.get("answer_anchor_hits") or 0)
    if plan and any(str(field) in {"attribute", "value"} for field in (plan.fields or [])):
        field_evidence = int(bool(field_evidence or discriminative_evidence >= 3 or anchor_evidence > 0))
    value_evidence = int(bool(field_evidence or relation_evidence or literal_evidence or numeric_evidence or ordinal_evidence or list_evidence or table_evidence
                              or unit_kinds & {"attribute_value", "attribute_sentence", "typed_sentence", "quoted_span"}))
    strong_slot_count = len({str(slot.get("slot_id")) for slot in requested_slots if value_evidence})
    weak_slot_count = len({str(slot.get("slot_id")) for slot in requested_slots})
    shape_match = int(bool(plan and (
        item.get("answer_shape") == plan.answer_shape
        or (plan.answer_shape == "list_item" and "list_item" in unit_kinds)
        or (plan.answer_shape == "table_cell" and table_evidence)
    )))
    speech_match = int(speech_act_compatible(getattr(plan, "speech_act_target", None) if plan else None,
                                             str(item.get("speech_act") or "")))
    answer_like = int(bool(str(item.get("speech_act") or "") in {
        "assistant_answer", "assistant_recommendation", "assistant_instruction", "user_statement",
    } and not _question_like_turn(item)))
    return (strong_slot_count, field_evidence, continuation_evidence, ordinal_evidence, list_evidence, table_evidence, literal_evidence, literal_length,
            relation_evidence, numeric_evidence, shape_match, speech_match, answer_like, weak_slot_count,
            int(item.get("speech_act_match") or 0), int(item.get("question_entity_hits") or 0),
            int(item.get("answer_anchor_hits") or 0), int(item.get("question_overlap") or 0),
            int(item.get("answer_overlap") or 0), int(float(item.get("score", 0) or 0) * 100))




def session_contract_rank(session_items: List[Dict[str, Any]], plan: QueryPlan | None = None,
                          primary_ids: set[str] | None = None) -> Tuple[int, ...]:
    """Return one deterministic quality key for a session contract."""
    if not session_items:
        return (0,)
    primary_items = [
        item for item in session_items
        if primary_ids and str(item.get("record_id") or "") in primary_ids
    ]
    evidence_items = primary_items or session_items
    slot_ids = {
        str(slot.get("slot_id"))
        for item in evidence_items
        for slot in ((plan.requested_slots if plan else []) or [])
        if slot.get("slot_id") and _slot_matches(slot, item)
        and _contract_item_rank(item, plan)[0] > 0
    }
    weak_slot_ids = {
        str(slot.get("slot_id"))
        for item in evidence_items
        for slot in ((plan.requested_slots if plan else []) or [])
        if slot.get("slot_id") and _slot_matches(slot, item)
    }
    best = max(_contract_item_rank(item, plan) for item in evidence_items)
    typed_relation = max((int(item.get("typed_relation_score") or 0) for item in evidence_items), default=0)
    typed_field = max((int(item.get("typed_field_match") or 0) for item in evidence_items), default=0)
    ordinal = max((int(item.get("ordinal_match") or 0) for item in evidence_items), default=0)
    literal_full = max((int(item.get("literal_full_hits") or 0) for item in evidence_items), default=0)
    numeric = max((int(item.get("numeric_hits") or 0) for item in evidence_items), default=0)
    answer_discriminative = max((int(item.get("answer_discriminative_hits") or 0) for item in session_items), default=0)
    requested_entity = max((int(item.get("requested_entity_hits") or 0) for item in evidence_items), default=0)
    relation = max((int(item.get("relation_hits") or 0) for item in evidence_items), default=0)
    continuation = max((int(item.get("preceding_terminal_literal_hits") or item.get("preceding_literal_hits") or 0)
                        for item in evidence_items), default=0)
    if plan and plan.ordinal_constraints:
        direct_contract_support = (
            typed_relation, typed_field, continuation, ordinal,
            answer_discriminative, literal_full, requested_entity, relation, numeric,
        )
    elif plan and plan.literals:
        direct_contract_support = (
            typed_relation, typed_field, continuation, literal_full, answer_discriminative,
            requested_entity, ordinal, numeric, relation,
        )
    elif plan and set(plan.fields) & {"amount", "percentage", "ratio", "year", "date", "duration", "count"}:
        direct_contract_support = (
            typed_relation, typed_field, continuation, numeric,
            answer_discriminative, requested_entity, relation, literal_full, ordinal,
        )
    else:
        direct_contract_support = (
            typed_relation, typed_field, continuation, requested_entity,
            answer_discriminative, relation, literal_full, ordinal, numeric,
        )
    session_contract_signal = (
        max((int(item.get("question_overlap") or 0) + int(item.get("question_entity_hits") or 0)
             for item in session_items), default=0)
        if (plan and (plan.literals or plan.ordinal_constraints or plan.relation_terms)) else 0,
        max((int(item.get("literal_full_hits") or 0) for item in session_items), default=0),
        max((int(item.get("literal_hits") or 0) for item in session_items), default=0),
        max((int(item.get("ordinal_match") or 0) for item in session_items), default=0),
        max((int(item.get("numeric_hits") or 0) for item in session_items), default=0),
        max((int(item.get("relation_hits") or 0) for item in session_items), default=0),
        max((int(item.get("typed_relation_score") or 0) for item in session_items), default=0),
        max((int(item.get("typed_field_match") or 0) for item in session_items), default=0),
        max((int(item.get("requested_entity_hits") or 0) for item in session_items), default=0),
    )
    topic_support = (
        max((int(item.get("event_topic_hits") or 0) for item in session_items), default=0),
        max((int(item.get("answer_anchor_hits") or 0) for item in session_items), default=0),
        max((int(item.get("answer_discriminative_hits") or 0) for item in session_items), default=0),
        max((int(item.get("query_overlap") or item.get("question_overlap") or 0) for item in session_items), default=0),
    )
    return (
        len(slot_ids), *direct_contract_support,
        topic_support[0], topic_support[1], topic_support[2], topic_support[3],
        *session_contract_signal,
        best[1], best[3], best[4], best[5],
        best[6], best[7], best[8], best[9],
        best[10], best[11], best[12], len(weak_slot_ids), best[14],
        best[16], best[17], best[18], best[19],
    )


def _primary_session_rank(item: Dict[str, Any], plan: QueryPlan | None = None) -> Tuple[int, ...]:
    speech_act = str(item.get("speech_act") or "")
    pair_type = str(item.get("pair_type") or "")
    role = str(item.get("role") or "")
    answer_units = item.get("answer_units") or []
    structured_kind = int(any(unit.get("kind") in {
        "table_coordinate", "table_cell", "table_row", "list_item",
        "quoted_span", "typed_sentence", "attribute_sentence",
    } for unit in answer_units))
    slot_hits = sum(1 for slot in ((plan.requested_slots if plan else []) or []) if _slot_matches(slot, item))
    historical_evidence = bool(
        slot_hits
        or structured_kind
        or int(item.get("typed_relation_score") or 0) > 0
        or int(item.get("typed_field_match") or 0) > 0
        or int(item.get("literal_hits") or 0) > 0
        or any(str(unit.get("kind") or "") == "special_literal" for unit in answer_units)
        or int(item.get("numeric_hits") or 0) > 0
        or int(item.get("answer_anchor_hits") or 0) > 0
        or int(item.get("answer_overlap") or 0) > 0
    )
    content_lower = str(item.get("text") or item.get("statement") or "").lower()
    user_self_reference = bool(re.search(r"\b(?:i|we|my|our|me|us)\b", content_lower))
    user_answer_evidence = bool(
        (
            int(item.get("typed_relation_score") or 0) > 0
            and int(item.get("typed_field_match") or 0) > 0
        )
        or (
            int(item.get("literal_full_hits") or 0) > 0
            and (
                int(item.get("requested_entity_hits") or 0) > 0
                or int(item.get("answer_discriminative_hits") or 0) > 0
            )
        )
        or (
            int(item.get("numeric_hits") or 0) > 0
            and int(item.get("typed_field_match") or 0) > 0
        )
        or (
            user_self_reference
            and int(item.get("answer_discriminative_hits") or 0) > 0
        )
        or (
            pair_type == "user_historical_statement"
            and any(str(unit.get("kind") or "") in {
                "quoted_span", "list_item", "typed_sentence", "attribute_sentence",
                "table_cell", "table_coordinate", "table_row", "numeric_value",
            } for unit in answer_units)
        )
    )
    historical_answer = int(
        role == "user"
        and speech_act == "user_statement"
        and historical_evidence
        and bool(plan and getattr(plan, "speech_act_target", None) == "historical_answer")
        and user_answer_evidence
        and (
            bool(item.get("question_turn_id"))
            or pair_type == "user_historical_statement"
            or user_self_reference
        )
    )
    answer_like = int(
        speech_act in {"assistant_answer", "assistant_recommendation", "assistant_instruction"}
        or historical_answer
        or (pair_type == "user_historical_statement" and user_answer_evidence)
        or slot_hits > 0
        or structured_kind > 0
    )
    question_like = int(_question_like_turn(item))
    contract = _contract_item_rank(item, plan)
    typed_specificity = 0
    if plan and (plan.answer_shape == "date" or "date" in (plan.fields or [])):
        typed_specificity = int(item.get("date_specificity") or 0)
    speech_target = getattr(plan, "speech_act_target", None) if plan else None
    speech_priority = {
        "assistant_answer": {"assistant_answer": 3, "assistant_recommendation": 2, "assistant_instruction": 1},
        "assistant_recommendation": {"assistant_recommendation": 3, "assistant_answer": 2, "assistant_instruction": 1},
        "historical_answer": {"user_statement": 3},
    }.get(speech_target, {}).get(speech_act, 0)
    semantic_answer_signal = bool(
        int(item.get("answer_discriminative_hits") or 0) > 0
        or int(item.get("typed_relation_score") or 0) > 0
        or int(item.get("typed_field_match") or 0) > 0
        or int(item.get("literal_hits") or 0) > 0
        or int(item.get("numeric_hits") or 0) > 0
        or int(item.get("ordinal_match") or 0) > 0
    )
    if not semantic_answer_signal:
        speech_priority = 0
    return (
        historical_answer,
        contract[0],
        contract[1],
        contract[2],
        contract[3],
        contract[6],
        contract[7],
        contract[8],
        typed_specificity,
        int(item.get("answer_discriminative_hits") or 0),
        speech_priority,
        contract[4],
        contract[5],
        contract[9],
        int(role == "assistant"),
        answer_like,
        int(not question_like),
        int(pair_type == "nearest_preceding_user"),
        int(item.get("typed_relation_score") or 0),
        int(item.get("typed_field_match") or 0),
        int(item.get("relation_hits") or 0),
        int(item.get("literal_full_hits") or 0),
        int(item.get("literal_max_length") or 0),
        int(item.get("literal_hits") or 0),
        int(item.get("ordinal_match") or 0),
        int(item.get("numeric_hits") or 0),
        structured_kind,
        int(item.get("question_overlap") or 0),
        int(item.get("question_entity_hits") or 0),
        -int(item.get("turn_index") or 0),
        int(item.get("answer_discriminative_hits") or 0),
        int(item.get("answer_anchor_hits") or 0),
        int(item.get("answer_overlap") or 0),
        int(item.get("unit_score") or 0),
        int(item.get("requested_entity_hits") or 0),
        int(float(item.get("score", 0) or 0) * 100),
    )

def _focused_session_closure(session_items: List[Dict[str, Any]], per_session_limit: int,
                             plan: QueryPlan | None = None) -> List[Dict[str, Any]]:
    if not session_items:
        return []
    answer_items = [item for item in session_items if item.get("speech_act") not in {
        "user_question", "assistant_question", "question"
    }] or session_items
    primary = max(answer_items, key=lambda item: _primary_session_rank(item, plan))
    chosen = [primary]
    chosen_ids = {str(primary.get("record_id") or "")}
    primary_id = str(primary.get("record_id") or "")
    ranked = sorted((item for item in session_items if str(item.get("record_id") or "") != primary_id),
                    key=lambda item: _focused_closure_rank(item, primary), reverse=True)
    for item in ranked:
        if len(chosen) >= per_session_limit:
            break
        record_id = str(item.get("record_id") or "")
        if record_id in chosen_ids:
            continue
        rank = _focused_closure_rank(item, primary)
        if rank[0] <= 0 and rank[2] == 0 and rank[1] == 0:
            continue
        enriched = dict(item)
        reasons = list(enriched.get("reasons") or enriched.get("reason") or [])
        if rank[2]:
            reasons.append("adjacent_turn_closure")
        if rank[1]:
            reasons.append("question_pair_closure")
        if rank[0]:
            reasons.append("typed_evidence_closure")
        enriched["reasons"] = list(dict.fromkeys(reasons))
        enriched["closure_relation"] = {
            "anchor_record_id": primary.get("record_id"),
            "turn_distance": abs(int(item.get("turn_index") or 0) - int(primary.get("turn_index") or 0)),
            "same_question": bool(rank[1]),
        }
        chosen.append(enriched)
        chosen_ids.add(record_id)
    return chosen


def _ordered_session_candidates(session_items: List[Dict[str, Any]],
                                plan: QueryPlan | None = None) -> List[Dict[str, Any]]:
    if not session_items:
        return []
    answer_items = [item for item in session_items if item.get("speech_act") not in {
        "user_question", "assistant_question", "question"
    }] or session_items
    primary = max(answer_items, key=lambda item: _primary_session_rank(item, plan))
    primary_id = str(primary.get("record_id") or "")
    remaining = [item for item in session_items if str(item.get("record_id") or "") != primary_id]
    remaining.sort(key=lambda item: (
        _focused_closure_rank(item, primary),
        int(item.get("turn_index") or 0),
        str(item.get("record_id") or ""),
    ), reverse=True)
    return [primary, *remaining]


def _candidate_slot_ids(item: Dict[str, Any], plan: QueryPlan) -> set[str]:
    return {
        str(slot.get("slot_id"))
        for slot in (plan.requested_slots or [])
        if slot.get("slot_id") and _slot_matches(slot, item)
    }


def _primary_answer_closure(session_items: List[Dict[str, Any]], plan: QueryPlan) -> List[Dict[str, Any]]:
    answer_items = [item for item in session_items if not _question_like_turn(item)] or list(session_items)
    if not answer_items:
        return []
    remaining = list(answer_items)
    selected: List[Dict[str, Any]] = []
    covered_slots: set[str] = set()
    requested_slots = {
        str(slot.get("slot_id")) for slot in (plan.requested_slots or []) if slot.get("slot_id")
    }
    multi_answer = bool(
        plan.answer_shape in {"list", "multi_value"}
        or int(plan.requested_count or 0) > 1
        or len(requested_slots) > 1
    )
    complementary_list = bool(getattr(plan, "complementary_list", False))
    requested_count = int(plan.requested_count or 0)
    list_expected = bool(
        plan.answer_shape in {"list", "list_item", "multi_value"}
        or requested_count > 1
        or complementary_list
    )

    def list_item_count(item: Dict[str, Any]) -> int:
        return sum(1 for unit in (item.get("answer_units") or []) if unit.get("kind") == "list_item")

    def list_item_keys(item: Dict[str, Any]) -> set[str]:
        keys = set()
        for unit in item.get("answer_units") or []:
            if unit.get("kind") != "list_item":
                continue
            value = unit.get("value") or unit.get("text") or (unit.get("source_span") or {}).get("text")
            if value:
                keys.add(str(value).strip().casefold())
        return keys

    def aggregate_list_keys() -> set[str]:
        return {key for item in selected for key in list_item_keys(item)}

    def list_completion_reached() -> bool:
        return requested_count > 0 and len(aggregate_list_keys()) >= requested_count

    def complete_list(item: Dict[str, Any]) -> int:
        return int(requested_count > 0 and list_item_count(item) >= requested_count)

    def continuation_answer(item: Dict[str, Any]) -> int:
        literal_follow_up = bool(
            plan.answer_shape == "literal" and "after" in (plan.referential_terms or [])
        )
        if plan.speech_act_target != "historical_answer" and not literal_follow_up:
            return 0
        if item.get("role") != "assistant" or _question_like_turn(item):
            return 0
        if item.get("answer_shape") != plan.answer_shape:
            return 0
        item_turn = int(item.get("turn_index") or 0)
        for anchor in answer_items:
            if anchor.get("role") != "user":
                continue
            anchor_literals = int(anchor.get("literal_full_hits") or 0)
            anchor_kinds = {str(unit.get("kind") or "") for unit in (anchor.get("answer_units") or [])}
            if not (anchor_literals or "special_literal" in anchor_kinds):
                continue
            anchor_turn = int(anchor.get("turn_index") or 0)
            if 0 < item_turn - anchor_turn <= 1:
                return 1
        return 0

    def list_fit(item: Dict[str, Any]) -> Tuple[int, int, int]:
        if not list_expected:
            return 0, 0, 0
        count = list_item_count(item)
        requested_count = int(plan.requested_count or 0)
        if requested_count <= 0:
            return int(count > 0), count, 0
        return int(count == requested_count), -abs(count - requested_count), int(count >= requested_count)

    def anchor_only(item: Dict[str, Any]) -> int:
        if not complementary_list or not plan.literals:
            return 0
        literal_hits = int(item.get("literal_full_hits") or item.get("literal_hits") or 0)
        return int(literal_hits > 0 and list_item_count(item) < max(int(plan.requested_count or 0), 2))

    while remaining:
        def key(item: Dict[str, Any]) -> Tuple[Any, ...]:
            new_slots = len(_candidate_slot_ids(item, plan) - covered_slots)
            exact_list, list_distance, list_complete = list_fit(item)
            return (
                continuation_answer(item),
                exact_list if list_expected else 0,
                list_distance if list_expected else 0,
                list_complete if list_expected else 0,
                -anchor_only(item) if list_expected else 0,
                _primary_session_rank(item, plan),
                int(new_slots > 0),
                new_slots,
            )

        primary = max(remaining, key=key)
        item_slots = _candidate_slot_ids(primary, plan)
        adds_list_items = bool(list_expected and (list_item_keys(primary) - aggregate_list_keys()))
        if selected and requested_slots and not (item_slots - covered_slots) and not (
                multi_answer and requested_count > 0 and adds_list_items):
            break
        selected.append(primary)
        covered_slots.update(item_slots)
        remaining = [item for item in remaining if item is not primary]
        if ((list_expected and complete_list(primary)) or (list_expected and list_completion_reached()) or not multi_answer
                or (not complementary_list and requested_slots and requested_slots <= covered_slots)):
            break
    return selected


def _fallback_session_ids(store: SQLiteStore, scope: Scope, plan: QueryPlan,
                           existing: List[str], limit: int = 24) -> List[str]:
    tokens = {token for token in expand_query_tokens(plan.query)
              if len(token) > 2 and token not in _SESSION_GENERIC_TERMS}
    tokens.update(entity.lower() for entity in plan.entity_candidates if entity)
    field_aliases = {
        "education.degree": {"degree", "graduate", "graduated", "education"},
        "duration": {"duration", "took", "spent", "hours", "minutes"},
        "year": {"year", "began", "started", "constructed"},
        "amount": {"amount", "cost", "price", "budget"},
        "count": {"count", "number", "many"},
    }
    for field_name in plan.fields:
        tokens.update(field_aliases.get(field_name, {field_name.lower()}))
    literal_terms = [literal.lower() for literal in plan.literals if literal]
    relation_terms = [term.lower() for term in plan.relation_terms if term]
    if not tokens:
        return []
    phrase_terms = [term.lower() for term in plan.referential_terms if len(term.split()) > 1]
    phrase_terms.extend(term.lower() for term in plan.event_recall_terms if len(term.split()) > 1)
    query_words = [token.lower() for token in expand_query_tokens(plan.query)
                   if len(token) > 2 and token not in _SESSION_GENERIC_TERMS and token.isalpha()]
    conjunction_words = list(dict.fromkeys(
        token for token in query_words
        if len(token) > 3 and token not in _SESSION_GENERIC_TERMS
    ))
    conjunction_pairs = [
        (left, right)
        for index, left in enumerate(conjunction_words)
        for right in conjunction_words[index + 1:]
    ]
    ordinal_values = [int(item.get("ordinal", 0)) for item in plan.ordinal_constraints
                      if int(item.get("ordinal", 0)) > 0]
    query_ngrams = {
        " ".join(query_words[index:index + size])
        for size in (2, 3)
        for index in range(len(query_words) - size + 1)
    }
    scores: Dict[str, Tuple[int, int, int]] = {}
    session_domain_hits: Dict[str, int] = {}
    session_ordinal_hits: Dict[str, int] = {}
    exact_sessions: Dict[str, int] = {}
    exact_literal_terms = [literal for literal in literal_terms
                           if not re.fullmatch(r"\d[\d,.]*", literal)]
    for observation in store.list_observations(scope, limit=50000):
        session_id = str(observation.metadata.get("session_id") or "")
        if not session_id:
            continue
        content = observation.content.lower()
        content_tokens = set(re.findall(r"[a-z0-9]+", content))
        exact_hits = sum(bool(entity) and entity.lower() in content for entity in plan.entity_candidates)
        exact_hits += sum(bool(literal) and _literal_present(content, literal) for literal in exact_literal_terms)
        if exact_hits:
            exact_sessions[session_id] = max(exact_sessions.get(session_id, 0), exact_hits)
        hits = 0
        for token in tokens:
            family = _token_family(token)
            if any(re.search(r"\b" + re.escape(variant) + r"\b", content) for variant in family):
                hits += 1
        literal_hits = sum(_literal_present(content, literal) for literal in literal_terms)
        literal_full_hits, literal_max_length = _literal_strength(content, literal_terms)
        relation_hits = sum(content.count(term) for term in relation_terms)
        for relation in relation_terms:
            relation_words = [word for word in re.findall(r"[a-z0-9]+", relation) if len(word) > 2]
            if len(relation_words) > 1 and all(word in content for word in relation_words):
                relation_hits += 2
        entity_hits = sum(content.count(entity.lower()) for entity in plan.entity_candidates if entity)
        if not hits and not literal_hits and not relation_hits and not entity_hits:
            continue
        phrase_hits = sum(content.count(phrase) for phrase in phrase_terms)
        phrase_hits += sum(content.count(ngram) for ngram in query_ngrams)
        conjunction_hits = sum(left in content_tokens and right in content_tokens
                               for left, right in conjunction_pairs)
        ordinal_list_hits = sum(bool(re.search(r"(?<!\w)" + str(ordinal) + r"\s*[.):]", content))
                             for ordinal in ordinal_values)
        domain_hits = sum(token in content_tokens for token in conjunction_words
                          if token not in {"list", "provided", "career", "employment", "think",
                                           "discussed", "earlier", "previous", "conversation",
                                           "remind", "remember"})
        session_domain_hits[session_id] = max(session_domain_hits.get(session_id, 0), domain_hits)
        session_ordinal_hits[session_id] = max(session_ordinal_hits.get(session_id, 0), ordinal_list_hits)
        phrase_hits += (literal_hits * 40 + literal_full_hits * 220 + literal_max_length
                        + exact_hits * 12 + conjunction_hits * 8 + relation_hits * 3 + entity_hits * 2)
        previous = scores.get(session_id, (0, 0, 0))
        scores[session_id] = (max(previous[0], hits), previous[1] + hits, previous[2] + phrase_hits)
    for session_id, values in list(scores.items()):
        closure_bonus = session_domain_hits.get(session_id, 0) * session_ordinal_hits.get(session_id, 0) * 80
        if closure_bonus:
            scores[session_id] = (values[0], values[1], values[2] + closure_bonus)
        exact_bonus = exact_sessions.get(session_id, 0)
        if exact_bonus:
            scores[session_id] = (values[0], values[1], scores[session_id][2] + exact_bonus * 10000)
    existing_order = {session_id: index for index, session_id in enumerate(existing)}
    ranked = sorted(scores.items(), key=lambda item: (
        -item[1][2], -item[1][0], -item[1][1], existing_order.get(item[0], len(existing_order) + 1), item[0]
    ))
    ranked_ids = [session_id for session_id, _ in ranked]
    ordered_ids = list(dict.fromkeys(ranked_ids))
    return ordered_ids[:max(limit, 1)]


def retrieve_episodic_evidence(store: SQLiteStore, scope: Scope, plan: QueryPlan,
                               seed_items: List[Dict[str, Any]], limit: int = 50,
                               focused: bool = False,
                               prefer_seed_order: bool = False,
                               preserve_all_session_candidates: bool = False) -> Tuple[List[Dict[str, Any]], List[Dict[str, Any]], Dict[str, Any]]:
    seed_session_ids = []
    for item in seed_items:
        session_id = item.get("session_id") or (item.get("metadata") or {}).get("session_id")
        if session_id and session_id not in seed_session_ids:
            seed_session_ids.append(str(session_id))
    fallback_session_ids = _fallback_session_ids(store, scope, plan, seed_session_ids, limit=512 if focused else 24)
    session_ids = list(fallback_session_ids) if prefer_seed_order else list(seed_session_ids)
    for session_id in fallback_session_ids:
        if session_id not in session_ids:
            session_ids.append(session_id)
    if prefer_seed_order:
        for session_id in seed_session_ids:
            if session_id not in session_ids:
                session_ids.append(session_id)
    candidates: List[Dict[str, Any]] = []
    episodes: List[Dict[str, Any]] = []
    episode_turns: Dict[str, List[Any]] = {}
    for session_id in session_ids:
        observations = store.list_observations(scope, session_id=session_id, limit=500)
        episode, turns = build_episode(observations, session_id)
        episodes.append(episode.as_dict())
        episode_turns[episode.episode_id] = turns
        candidates.extend(answer_candidates(episode, turns, plan, max_chars=None))
    candidates.sort(key=lambda item: (-float(item.get("score", 0)), str(item.get("record_id", ""))))
    selection_limit = max(min(limit, len(candidates)), 1)
    selected = []
    selected_ids = set()
    session_counts: Dict[str, int] = {}
    historical_answer_query = bool(re.search(r"\b(?:i|we)\s+(?:mentioned|said|used|recommended|suggested|gave|bought|visited|wore|chose)\b", plan.query.lower()))
    if not focused or preserve_all_session_candidates:
        # Unbounded diagnostic mode must retain every generated candidate.
        # Its purpose is to diagnose the complete evidence chain, not to apply
        # the focused per-session cap used by hard/focused retrieval.
        per_session_limit = max(len(candidates), 1)
    elif plan.answer_shape in {
        "entity", "attribute", "list", "list_item", "table_cell", "multi_value"
    }:
        per_session_limit = max(4, int(plan.requested_count or 0) + 2, 8 if historical_answer_query else 0)
    else:
        per_session_limit = 3

    def add_candidate(item: Dict[str, Any]) -> bool:
        if len(selected) >= selection_limit:
            return False
        record_id = str(item.get("record_id") or "")
        if record_id in selected_ids:
            return False
        session_id = str(item.get("session_id") or "")
        if session_counts.get(session_id, 0) >= per_session_limit:
            return False
        selected.append(item)
        selected_ids.add(record_id)
        session_counts[session_id] = session_counts.get(session_id, 0) + 1
        return True

    candidates_by_session: Dict[str, List[Dict[str, Any]]] = {}
    for item in candidates:
        candidates_by_session.setdefault(str(item.get("session_id") or ""), []).append(item)
    if focused and not preserve_all_session_candidates:
        def session_quality(session_id: str) -> Tuple[int, ...]:
            return session_contract_rank(candidates_by_session[session_id], plan)

        if prefer_seed_order:
            ranked_sessions = sorted(
                candidates_by_session,
                key=lambda session_id: (
                    -(session_ids.index(session_id) if session_id in session_ids else len(session_ids)),
                    session_quality(session_id),
                    session_id,
                ),
                reverse=True,
            )
        else:
            ranked_sessions = sorted(
                candidates_by_session,
                key=lambda session_id: (
                    session_quality(session_id),
                    -(session_ids.index(session_id) if session_id in session_ids else len(session_ids)),
                    session_id,
                ),
                reverse=True,
            )
        for session_id in ranked_sessions:
            session_items = candidates_by_session.get(session_id, [])
            if session_items:
                for item in _focused_session_closure(session_items, per_session_limit, plan):
                    if len(selected) >= selection_limit:
                        break
                    add_candidate(item)
            if len(selected) >= selection_limit:
                break
    else:
        ranked_sessions = [session_id for session_id in session_ids if session_id in candidates_by_session]
        ranked_sessions.extend(session_id for session_id in candidates_by_session if session_id not in ranked_sessions)
        ordered_candidates_by_session = {
            session_id: _ordered_session_candidates(session_items, plan)
            for session_id, session_items in candidates_by_session.items()
        }
        for round_index in range(per_session_limit):
            for session_id in ranked_sessions:
                session_items = ordered_candidates_by_session.get(session_id, [])
                if round_index >= len(session_items):
                    continue
                add_candidate(session_items[round_index])
                if len(selected) >= selection_limit:
                    break
            if len(selected) >= selection_limit:
                break
    selected_ids = {item["record_id"] for item in selected}
    bundles: List[Dict[str, Any]] = []
    for episode in episodes:
        episode_items = [item for item in selected if item.get("episode_id") == episode["episode_id"]]
        if not episode_items:
            continue
        all_turns = episode_turns.get(episode["episode_id"], [])
        primary_items = _primary_answer_closure(episode_items, plan)
        primary_ids = {str(item.get("record_id") or "") for item in primary_items}
        anchor_indexes = {int(item.get("turn_index") or 0) for item in primary_items}
        question_turns = []
        for item in primary_items:
            question_turn_id = item.get("question_turn_id")
            question_turns.extend(turn for turn in all_turns if turn.turn_id == question_turn_id)
        question_turns = sorted({turn.turn_id: turn for turn in question_turns}.values(), key=lambda turn: turn.turn_index)[-3:]
        answer_turns = [turn for turn in all_turns if turn.turn_index in anchor_indexes]
        related_turns = [turn for turn in all_turns if any(abs(turn.turn_index - index) <= 1 for index in anchor_indexes)
                         and turn.turn_id not in {item.turn_id for item in answer_turns}]
        related_turns = sorted(related_turns, key=lambda turn: (abs(turn.turn_index - min(anchor_indexes, default=0)), turn.turn_index))[:8]
        required_units = [unit for item in primary_items for unit in item.get("answer_units", [])]
        optional_related_ids = [turn.turn_id for turn in related_turns]
        question_pair_ids = list(dict.fromkeys(
            [turn.turn_id for turn in question_turns]
            + [item.get("question_turn_id") for item in primary_items if item.get("question_turn_id")]
        ))
        def compact_turn(turn: Any) -> Dict[str, Any]:
            return {"turn_id": turn.turn_id, "observation_id": turn.observation_id, "turn_index": turn.turn_index,
                    "role": turn.role, "content": turn.content, "observed_at": turn.observed_at}
        bundles.append({"bundle_id": "bundle:" + episode["episode_id"], "episode_id": episode["episode_id"],
                        "session_id": episode["root_session_id"], "anchor_candidates": [item["record_id"] for item in primary_items],
                        "primary_answer_candidate_ids": [item["record_id"] for item in primary_items],
                        "primary_answer_turn_ids": [turn.turn_id for turn in answer_turns],
                        "question_pair_ids": question_pair_ids,
                        "required_answer_units": required_units[:96],
                        "optional_related_turn_ids": optional_related_ids,
                        "answer_candidates": [dict(item) for item in primary_items],
                        "question_turn_ids": [turn.turn_id for turn in question_turns],
                        "answer_turn_ids": [turn.turn_id for turn in answer_turns],
                        "related_turn_ids": optional_related_ids,
                        "question_turns": [compact_turn(turn) for turn in question_turns],
                        "answer_turns": [compact_turn(turn) for turn in answer_turns],
                        "related_turns": [compact_turn(turn) for turn in related_turns],
                        "chronological_order": [turn.turn_index for turn in sorted(related_turns, key=lambda x: x.turn_index)],
                        "role_sequence": [turn.role for turn in sorted(related_turns, key=lambda x: x.turn_index)],
                        "structured_facts": [fact for item in primary_items for fact in item.get("structured_facts", [])][:96],
                        "facets": [facet for item in primary_items for facet in item.get("facets", [])][:96],
                        "answer_units": required_units[:96],
                        "source_spans": [span for item in primary_items for span in item.get("source_span", [])][:96],
                        "source_observations": [item["observation_id"] for item in primary_items],
                        "coverage": {"answer_candidate": bool(answer_turns), "question_turn": bool(question_turns),
                                     "source_span": any(item.get("source_span") for item in primary_items),
                                     "requested_slots": len({slot_id for item in primary_items for slot_id in _candidate_slot_ids(item, plan)}),
                                     "primary_answer": bool(primary_items)},
                        "confidence": max(float(item.get("confidence", 0)) for item in primary_items),
                        "reasons": ["episode_seed", "answer_candidate", "evidence_closure"]})
    trace = {"target_episode_count": len(episodes), "candidate_count": len(candidates),
             "selected_candidate_count": len(selected), "target_episode_hit": bool(episodes),
             "answer_candidate_hit": bool(selected), "answer_span_coverage": sum(bool(item.get("source_span")) for item in selected),
             "closure_truncated": len(candidates) > len(selected), "closure_count": len(selected),
             "closure_ids": sorted(selected_ids)}
    return selected, bundles, trace




